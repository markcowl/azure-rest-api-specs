{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/azure-rest-api-specs/eng/tools/breaking-change-evaluator/breaking-change-evaluator.schema.json",
  "title": "Breaking-change evaluator report",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "complete",
    "generatedAt",
    "qualification",
    "provenance",
    "dimensions",
    "oadFindings",
    "typeSpecProjects",
    "matches",
    "findingGroups",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": {
      "enum": ["evaluated", "partial", "not-qualified", "failed"]
    },
    "complete": { "type": "boolean" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pullRequest": {
      "type": "object",
      "required": [
        "owner",
        "repo",
        "number",
        "merged",
        "url",
        "baseSha",
        "headSha",
        "changedTypeSpecFiles"
      ],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "state": { "type": "string" },
        "merged": { "type": "boolean" },
        "url": { "type": "string", "format": "uri" },
        "baseBranch": { "type": "string" },
        "headBranch": { "type": "string" },
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mergedAt": { "type": "string", "format": "date-time" },
        "changedTypeSpecFiles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["qualified", "reasonCodes", "evidence"],
      "properties": {
        "qualified": { "type": "boolean" },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "object" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evaluator": {
          "type": "object",
          "required": ["commit"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          },
          "additionalProperties": false
        },
        "pr": {
          "type": "object",
          "required": ["url", "headSha", "baseSha"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          },
          "additionalProperties": false
        },
        "tool": {
          "type": "object",
          "required": ["sourceSha", "artifactDigest"],
          "properties": {
            "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dimensions": { "type": "array", "items": { "type": "object" } },
    "oadFindings": { "type": "array", "items": { "type": "object" } },
    "typeSpecProjects": { "type": "array", "items": { "type": "object" } },
    "matches": { "type": "array", "items": { "type": "object" } },
    "findingGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "key", "oadOccurrenceIds", "typeSpecOccurrenceIds"],
        "properties": {
          "category": {
            "enum": [
              "exact",
              "probable-review",
              "intentional-swagger-only",
              "missed-equivalent",
              "typespec-only",
              "ambiguous",
              "errors"
            ]
          },
          "key": { "type": "string" },
          "swaggerRule": { "type": "string" },
          "typeSpecKind": { "type": "string" },
          "oadOccurrenceIds": { "type": "array", "items": { "type": "string" } },
          "typeSpecOccurrenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "reproduction": {
      "type": "object",
      "required": [
        "shell",
        "evaluatorCommit",
        "analyzerSourceSha",
        "analyzerArtifactDigest",
        "prHeadSha",
        "prBaseSha",
        "setupCommands",
        "evaluatorCommand",
        "directAnalyzerCommands"
      ],
      "properties": {
        "shell": { "const": "powershell" },
        "evaluatorCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "analyzerSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "analyzerArtifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "prBaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "setupCommands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "evaluatorCommand": { "$ref": "#/$defs/command" },
        "directAnalyzerCommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      },
      "additionalProperties": false
    },
    "rollup": { "type": "object" },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "complete": { "const": false } } },
      "then": { "not": { "required": ["rollup"] } }
    },
    {
      "if": { "properties": { "status": { "const": "evaluated" } } },
      "then": {
        "properties": { "complete": { "const": true } },
        "required": ["rollup", "pullRequest", "reproduction"]
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "required": ["label", "command"],
      "properties": {
        "label": { "type": "string" },
        "command": { "type": "string" },
        "project": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
