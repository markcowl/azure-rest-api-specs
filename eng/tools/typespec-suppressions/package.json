{
  "name": "@azure-tools/typespec-suppressions",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "typespec-suppressions": "cmd/typespec-suppressions.js"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "npm run build && npm run lint && npm run format:check && npm run test:ci",
    "format": "prettier . --ignore-path ../.prettierignore --write",
    "format:check": "prettier . --ignore-path ../.prettierignore --check",
    "format:check:ci": "prettier . --ignore-path ../.prettierignore --check --log-level debug",
    "lint": "cross-env DEBUG=eslint:eslint,eslint:linter eslint",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@typespec/compiler": "next",
    "simple-git": "^3.27.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.0"
  }
}
