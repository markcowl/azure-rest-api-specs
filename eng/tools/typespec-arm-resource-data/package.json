{
  "name": "@azure-tools/typespec-arm-resource-data-report",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "typespec-arm-resource-data": "cmd/typespec-arm-resource-data.js"
  },
  "dependencies": {
    "@azure-tools/typespec-azure-resource-manager": "catalog:",
    "@typespec/compiler": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "version": "1.0.0"
}
